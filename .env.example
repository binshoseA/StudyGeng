# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env ke GitHub.
PORT=3000
NODE_ENV=development

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rahasia acak. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
OTP_SECRET=

# Email OTP (SMTP). Kosongkan saat belajar: kode OTP akan tampil di terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StudyGeng <noreply@example.com>"

# Google OAuth (Tahap 4)
GOOGLE_CLIENT_ID=
